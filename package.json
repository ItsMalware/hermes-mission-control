{
  "name": "hermes-mission-control",
  "version": "3.0.0",
  "private": true,
  "description": "Hermes Mission Control — AI desktop shell built on Nous hermes-agent",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run -w apps/desktop dev",
    "build": "npm run -w apps/desktop build",
    "start": "npm run -w apps/desktop start",
    "dist": "npm run -w apps/desktop dist",
    "dist:mac": "npm run -w apps/desktop dist:mac",
    "test": "npm run -w apps/desktop test",
    "lint": "npm run -w apps/desktop lint",
    "typecheck": "npm run -w apps/desktop typecheck",
    "clean": "npm run -w apps/desktop clean"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
